{
  "expo": {
    "name": "ChitraX",
    "slug": "chitra-video-player",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "chitravideoplayer",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.chitravideoplayer",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow ChitraX to access your media library to discover and play videos saved on your device.",
        "NSPhotoLibraryAddUsageDescription": "Allow ChitraX to save videos to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08090C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.anonymous.chitravideoplayer",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ChitraX to access your video files.",
          "saveToLibraryPermission": "Allow ChitraX to save videos.",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "video"
          ]
        }
      ],
      "react-native-video",
      "expo-screen-orientation",
      "expo-sharing",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb00ac6a-bb3f-4526-9d49-4c7d704cbd2c"
      }
    }
  }
}
